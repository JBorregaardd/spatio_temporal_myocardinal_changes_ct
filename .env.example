# Copy to .env (not committed) and adjust. Patterns are relative to their folder; {id} is the patient id
# and * matches anything except "/".

# --- Local (ImageCAS in <repo>/data) ---
PROJECT_ROOT=/Users/signeolsen/Desktop/spatio_temporal_myocardinal_changes_ct
IMAGE_FOLDER=${PROJECT_ROOT}/data/1_200
IMAGE_PATTERN={id}.img.nii.gz
SEGMENTATION_FOLDER=${PROJECT_ROOT}/data/TotalSegmentator
SEGMENTATION_PATTERN={id}.heart.nii.gz

