# Copy this file to `.env` and fill in the paths for your machine.
# `.env` itself is gitignored, so this is what gets committed instead -
# it documents which variables main_single.py expects.
#
# On a cluster, prefer exporting these as real environment variables from
# your job script (e.g. SLURM `--export=` or `export PROJECT_ROOT=...`)
# instead of shipping a .env file - real env vars always take precedence
# over anything in .env, so both approaches can coexist.

# Root of this project (contains data/, output/, LVM_thickness/, ...)
PROJECT_ROOT=/path/to/spatio_temporal_myocardinal_changes_ct

# Folder containing the TotalSegmentator heart segmentations
# (<PROJECT_ROOT>/data/TotalSegmentator on a normal local checkout)
SEGMENTATION_FOLDER=/path/to/spatio_temporal_myocardinal_changes_ct/data/TotalSegmentator

# Optional: which patient id to run when main_single.py is invoked with
# no --patient-id argument. Handy for cluster array jobs that set this
# per-task instead of editing the script.
# PATIENT_ID=1
