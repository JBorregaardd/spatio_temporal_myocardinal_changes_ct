# Copy to .env (not committed) and adjust. Patterns are relative to their folder; {id} is the patient id
# and * matches anything except "/".

# --- Local (ImageCAS in <repo>/data) ---
PROJECT_ROOT=/Users/signeolsen/Desktop/spatio_temporal_myocardinal_changes_ct
IMAGE_FOLDER=${PROJECT_ROOT}/data/1_200
IMAGE_PATTERN={id}.img.nii.gz
SEGMENTATION_FOLDER=${PROJECT_ROOT}/data/TotalSegmentator
SEGMENTATION_PATTERN={id}.heart.nii.gz

# --- Remote (CGPS 10y, data outside the repo) ---
# PROJECT_ROOT=/path/to/your/clone/of/spatio_temporal_myocardinal_changes_ct
# IMAGE_FOLDER=/storage/Data/DTU-CGPS-10y-august-2026/NIFTI
# META_DATA_FILE=/storage/Data/DTU-CGPS-10y-august-2026/metadata/DTU-CGPS-10y-august-2026_meta_data_success_2026-08-07-09-47-32.csv
# IMAGE_PATTERN=CGPS-10y-august-2026_{id}_*_volume_1.nii.gz
# SEGMENTATION_FOLDER=/storage/Data/AortaExplorer/DTU-CGPS-10y-august-2026/Cardiac_ED_CE
# SEGMENTATION_PATTERN=CGPS-10y-august-2026_{id}_*/segmentations/heartchambers_highres.nii.gz
